{
    "schemaVersion": "1.0",
    "swiftCompiler": {
        "extraCLIOptions": [
            "-enable-experimental-feature", "Embedded",
            "-enable-experimental-feature", "CodeGenerationModel=implementation",
            "-Xfrontend", "-function-sections",
            "-Xfrontend", "-disable-stack-protector",
            "-Xcc", "-fno-pic",
            "-Xlinker-driver", "-nostdlib",
            "-Xlinker-driver", "-fuse-ld=lld"
        ]
    },
    "cCompiler": {
        "extraCLIOptions": [
            "-fno-pic"
        ]
    },
    "linker": {
        "extraCLIOptions": [
            "-nostdlib",
            "-static",
            "--gc-sections",
            "--strip-all",
            "--orphan-handling=error",
            "-T", "linker.ld",
            "-Map", ".build/kernel.map"
        ]
    },
    "debugger": {
        "path": "/usr/bin/env",
        "extraCLIOptions": [
            "qemu-system-aarch64",
            "-machine", "raspi4b",
            "-serial", "stdio",
            "-kernel"
        ]
    }
}
